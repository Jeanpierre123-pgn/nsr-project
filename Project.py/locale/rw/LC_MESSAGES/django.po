msgid "Only farmers and buyers can view order agreements."
msgstr ""
"Abahinzi n'abaguzi gusa ni bo bashobora kureba amasezerano ya komande."

msgid "Order changes must be submitted with POST."
msgstr "Impinduka kuri komande zigomba koherezwa hakoreshejwe POST."

msgid "Enter a valid agreed price before confirming."
msgstr "Andika igiciro mwumvikanyeho cyemewe mbere yo kwemeza."

msgid "That order transition is not permitted."
msgstr "Ihinduka ry'iyi komande ntiryemewe."

msgid "Order #%(number)s updated to %(status)s."
msgstr "Komande ya #%(number)s yahinduwe iba %(status)s."

msgid "Transport requests require a registered platform role."
msgstr ""
"Ibyifuzo by'ubwikorezi bisaba konti ifite uruhare rwanditse kuri uru rubuga."

msgid "Only the buyer or farmer in this order can request transport."
msgstr ""
"Umuguzi cyangwa umuhinzi uri muri iyi komande ni we gusa ushobora gusaba "
"ubwikorezi."

msgid "Confirm the order agreement before arranging transport."
msgstr "Banza wemeze amasezerano ya komande mbere yo gutegura ubwikorezi."

msgid "A transport request already exists for this order."
msgstr "Iyi komande isanzwe ifite icyifuzo cy'ubwikorezi."

msgid "Transport request posted for registered transporters."
msgstr ""
"Icyifuzo cy'ubwikorezi cyashyizweho kugira ngo abatwara ibicuruzwa "
"biyandikishije bakibone."

msgid "Transport changes must be submitted with POST."
msgstr "Impinduka ku bwikorezi zigomba koherezwa hakoreshejwe POST."

msgid "Your registered vehicle capacity is below this order quantity."
msgstr ""
"Ubushobozi bw'ikinyabiziga cyawe wandikishije buri munsi y'ingano y'iyi "
"komande."

msgid "That transport action is not permitted."
msgstr "Icyo gikorwa cy'ubwikorezi nticyemewe."

msgid "Transport request updated."
msgstr "Icyifuzo cy'ubwikorezi cyahinduwe."

